{
  "name": "netwatch",
  "version": "1.0.0",
  "private": true,
  "description": "NetWatch - Internal infrastructure monitoring (Supabase + Vercel)",
  "scripts": {
    "dev": "pnpm -C apps/frontend dev",
    "build": "pnpm -C apps/frontend build",
    "start": "pnpm -C apps/frontend start",
    "lint": "pnpm -C apps/frontend lint",
    "test": "pnpm -C apps/frontend test",
    "typecheck": "pnpm -C apps/frontend typecheck",
    "check": "pnpm test && pnpm typecheck",
    "db:seed": "node scripts/seed-supabase.mjs",
    "db:seed:legacy": "node scripts/seed-demo-user.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^2.4.3"
  }
}
