<Project>
  <!-- Settings shared by every NetWatch project. -->
  <PropertyGroup>
    <!-- Plain "-windows" (no Windows SDK projection needed). The minimum OS (Windows Server 2019 / Windows 10 1809)
         is enforced by the installer (MinVersion=10.0.17763). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Version>2.0.0</Version>
    <Company>NetWatch</Company>
    <Product>NetWatch</Product>
    <Copyright>NetWatch</Copyright>

    <!-- Every resolved package (including transitive ones) and its content hash is pinned in packages.lock.json;
         build.ps1 restores in locked mode, so a changed or tampered package fails the build. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The publish runs with -r win-x64 for every project: the lock files pin that runtime graph too. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RestoreLockedMode Condition="'$(NetWatchLockedRestore)' == 'true'">true</RestoreLockedMode>

    <!-- Central package management: every package version lives in Directory.Packages.props. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- No telemetry or update checks from the build tooling either. -->
    <DOTNET_CLI_TELEMETRY_OPTOUT>1</DOTNET_CLI_TELEMETRY_OPTOUT>
  </PropertyGroup>
</Project>
