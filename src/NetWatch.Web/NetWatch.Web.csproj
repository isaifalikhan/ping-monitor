<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NetWatch.Web</RootNamespace>
    <Description>REST API, SignalR hub, authentication and the embedded React web UI.</Description>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="System.DirectoryServices.Protocols" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetWatch.Core\NetWatch.Core.csproj" />
    <ProjectReference Include="..\NetWatch.Data\NetWatch.Data.csproj" />
    <ProjectReference Include="..\NetWatch.Collectors\NetWatch.Collectors.csproj" />
    <ProjectReference Include="..\NetWatch.Alerts\NetWatch.Alerts.csproj" />
  </ItemGroup>

  <!-- The built UI (npm run build â†’ ClientApp/dist) is embedded into the assembly, so the service exe is self-contained. -->
  <ItemGroup>
    <EmbeddedResource Include="ClientApp\dist\**\*" />
    <None Remove="ClientApp\**" />
    <Content Remove="ClientApp\**" />
    <Compile Remove="ClientApp\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetWatch.Tests" />
  </ItemGroup>

</Project>
