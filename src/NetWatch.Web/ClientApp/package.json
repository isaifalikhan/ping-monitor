{
  "name": "netwatch-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NetWatch web console (bundled into NetWatch.Service.exe; no external requests at runtime).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-offline.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@microsoft/signalr": "8.0.7",
    "@tanstack/react-query": "5.62.0",
    "@tanstack/react-virtual": "3.10.9",
    "echarts": "5.5.1",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
