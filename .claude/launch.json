{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "netwatch-simulator",
      "runtimeExecutable": "artifacts/publish/NetWatch.Service.exe",
      "runtimeArgs": ["--console", "--simulate", "--data-dir", ".data"],
      "url": "https://localhost:8444",
      "port": 8444
    },
    {
      "name": "netwatch-simulator-incidents",
      "runtimeExecutable": "artifacts/publish/NetWatch.Service.exe",
      "runtimeArgs": ["--console", "--simulate", "--data-dir", ".data"],
      "env": { "NETWATCH_SIM_INCIDENT_RATE": "400" },
      "url": "https://localhost:8444",
      "port": 8444
    },
    {
      "name": "netwatch-dev-simulator",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["src/NetWatch.Service/bin/Debug/net10.0-windows/NetWatch.Service.dll", "--console", "--simulate", "--data-dir", ".data/dev-sim", "--Https:Port=8451"],
      "env": { "NETWATCH_SIM_INCIDENT_RATE": "400" },
      "url": "https://localhost:8451",
      "port": 8451
    }
  ]
}
